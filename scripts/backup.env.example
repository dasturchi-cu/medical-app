# Nusxa: backup.env deb saqlang (Git ga kirmaydi).
# Supabase Dashboard -> Project -> Connect -> Session pooler -> URI (to'liq nusxa).
# Region va hostni qo'lda taxmin qilmang — faqat Dashboard dagi URI.

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
